doctype html
head
  title Vendigroth Sonics | Viktor Břenek
  meta(content="text/html;charset=utf-8", http-equiv="Content-Type")
  meta(content="utf-8", http-equiv="encoding")
  meta(name="author" content="Viktor Brenek")
  meta(name="description" content="Generátor hudby pro pusté světy: flétny, struny, bubny a spóry")
  meta(property="og:image" content="http://viktorbrenek.github.io/assets/images/icon-512.png")
  meta(name="viewport" content="width=device-width,initial-scale=1.0")
  link(rel="stylesheet", href="styles.css")
  link(rel="icon" href="assets/images/favicon.png" sizes="any")
  link(rel="icon" href="assets/images/icon.svg" type="image/svg+xml")
  link(rel="apple-touch-icon" href="assets/images/apple-touch-icon.png")
  link(rel="manifest" href="/manifest.json")
  script(src="site.js" defer)
  script(src="vendigroth-sonics.js" defer)

body(data-page="tool-sonics")
  header.site-header
    .site-header__inner
      a.brand(href="index.html")
        span.brand__sigil V
        span.brand__text
          span.brand__eyebrow Nástroje
          span.brand__name Viktor Břenek
      button.nav-toggle(type="button" aria-expanded="false") Menu
      nav.site-nav
        a(href="about.html") O mně
        a(href="blog.html") Blog
        a(href="gamedev.html") Vývoj her
        a(href="design.html") Design
        a(href="illustrations.html") Ilustrace
        a(href="uxdesign.html") UX/UI
      ul.social-links
        li
          a(href="https://instagram.com/viktorbrenek" target="_blank" rel="noreferrer") Instagram
        li
          a(href="https://facebook.com/brenekviktor/" target="_blank" rel="noreferrer") Facebook
        li
          a(href="https://twitch.tv/viktorbrenek" target="_blank" rel="noreferrer") Twitch
        li
          a(href="https://discord.com/invite/2Uj6N5N" target="_blank" rel="noreferrer") Discord
        li
          a(href="https://www.youtube.com/ViktorBrenekYT" target="_blank" rel="noreferrer") Youtube

  main.page-shell
    section.page-hero
      p.eyebrow Nástroje
      h1 Vendigroth Sonics
      p.lead
        | Skladatel hudby pro pusté světy. Z názvu stopy složí téma, harmonii i stavbu skladby: flétny a struny z Východu, těžké bubny, občas kytara a spóry ve větru. Stejný název zní vždy stejně.
      p.hero-kicker
        a.link-pill(href="tools.html") Zpět na přehled nástrojů

    section.tool-panel
      .tool-workbench.tool-workbench--sonics
        .tool-workbench__sidebar
          header.tool-workbench__header
            .tool-workbench__sigil 🎛️
            h2.tool-workbench__title Vendigroth Sonics
          .tool-workbench__body
            .tool-workbench__field
              label.tool-workbench__label(for="preset") Předvolba
              select#preset.tool-workbench__input
                option(value="spory") Spóry v mlze
                option(value="popel") Vítr nad popelem
                option(value="bazar") Bazar u brány
                option(value="vraky") Pohřebiště vzducholodí
                option(value="lotos") Lotosový břeh
                option(value="prusmyk") Šeptající průsmyk
                option(value="custom") Vlastní
            .tool-workbench__field
              label.tool-workbench__label(for="track-name") Název skladby (seed)
              input#track-name.tool-workbench__input(type="text" value="Spóry v mlze" autocomplete="off")
            .tool-workbench__checkbox-row
              label.tool-workbench__checkbox
                input#auto-seed(type="checkbox")
                span.tool-workbench__checkbox-box
                span.tool-workbench__checkbox-text Nastavení podle názvu
            .tool-workbench__field
              label.tool-workbench__label(for="audio-biome") Atmosféra
              select#audio-biome.tool-workbench__input.manual-input
                option(value="tavern") Bazar
                option(value="ashlands") Terasové pole popela
                option(value="bamboo") Lotosové břehy rzi
                option(value="dunes") Pohřebiště vzducholodí
                option(value="fungal") Visuté město
                option(value="ruins") Průsmyk šeptajících spór
                option(value="catacombs") Labyrint zrcadlových očí
            .tool-workbench__field
              label.tool-workbench__label(for="audio-mood") Nálada
              select#audio-mood.tool-workbench__input.manual-input
                option(value="meditative") Meditativní
                option(value="pilgrim") Poutnická
                option(value="melancholy") Melancholická
                option(value="ominous") Zlověstná
                option(value="ritual") Rituální
            .tool-workbench__field
              label.tool-workbench__label(for="lead-inst") Sólový nástroj
              select#lead-inst.tool-workbench__input.manual-input
                option(value="auto") Podle atmosféry
                option(value="shaku") Šakuhači
                option(value="flute") Flétna
                option(value="duduk") Duduk
            .tool-workbench__field
              label.tool-workbench__label(for="story-curve") Vývoj skladby
              select#story-curve.tool-workbench__input.manual-input
                option(value="slow_burn") Pomalé probuzení
                option(value="sudden_danger") Náhlá hrozba
                option(value="ambient_waves") Klidné vlny
                option(value="constant_tension") Trvalé napětí
            .tool-workbench__row
              .tool-workbench__field
                label.tool-workbench__label.tool-workbench__label--small(for="vol-flute") Flétny
                input#vol-flute.tool-workbench__range.mix-input(type="range" min="0" max="1" step="0.05" value="0.6")
              .tool-workbench__field
                label.tool-workbench__label.tool-workbench__label--small(for="vol-pluck") Struny a kytara
                input#vol-pluck.tool-workbench__range.mix-input(type="range" min="0" max="1" step="0.05" value="0.6")
            .tool-workbench__row
              .tool-workbench__field
                label.tool-workbench__label.tool-workbench__label--small(for="vol-pad") Smyčce a plochy
                input#vol-pad.tool-workbench__range.mix-input(type="range" min="0" max="1" step="0.05" value="0.5")
              .tool-workbench__field
                label.tool-workbench__label.tool-workbench__label--small(for="vol-drums") Bicí
                input#vol-drums.tool-workbench__range.mix-input(type="range" min="0" max="1" step="0.05" value="0.5")
            .tool-workbench__row
              .tool-workbench__field
                label.tool-workbench__label.tool-workbench__label--small(for="vol-drone") Drony
                input#vol-drone.tool-workbench__range.mix-input(type="range" min="0" max="1" step="0.05" value="0.55")
              .tool-workbench__field
                label.tool-workbench__label.tool-workbench__label--small(for="vol-wind") Vítr a spóry
                input#vol-wind.tool-workbench__range.mix-input(type="range" min="0" max="1" step="0.05" value="0.4")
            .tool-workbench__row
              .tool-workbench__field
                label.tool-workbench__label.tool-workbench__label--small(for="tempo-density") Hustota melodie
                input#tempo-density.tool-workbench__range.manual-input(type="range" min="0.2" max="1.4" step="0.05" value="0.8")
              .tool-workbench__field
                label.tool-workbench__label.tool-workbench__label--small(for="reverb-depth") Hloubka ozvěny
                input#reverb-depth.tool-workbench__range.mix-input(type="range" min="0.1" max="1" step="0.05" value="0.65")
            .tool-workbench__actions
              button#btn-play.world-map__button(type="button") Zahrát skladbu
              button#btn-record.world-map__button.world-map__button--secondary(type="button") Stáhnout skladbu (WAV)
        .tool-workbench__canvas-panel
          .tool-workbench__canvas-shell.tool-workbench__canvas-shell--sonics
            p.tool-workbench__canvas-title Náhled zvukové krajiny
            p.tool-workbench__canvas-text#status-text Neaktivní. Spusť hudbu a nech nástroj složit skladbu podle názvu.
            .tool-workbench__canvas-frame.tool-workbench__canvas-frame--wide
              canvas#audio-canvas(width="560" height="360")
            .sonics-meta-grid
              article.sonics-meta-card
                p.sonics-meta-card__label Atmosféra
                p#biome-readout.sonics-meta-card__value Popelavé pláně
              article.sonics-meta-card
                p.sonics-meta-card__label Nálada
                p#mood-readout.sonics-meta-card__value Meditativní
              article.sonics-meta-card
                p.sonics-meta-card__label Export
                p#record-progress.sonics-meta-card__value Celá skladba do WAV
              article.sonics-meta-card
                p.sonics-meta-card__label Tónina a tempo
                p#pattern-readout.sonics-meta-card__value –
          .sonics-timeline-panel
            p.sonics-timeline-title Stavba skladby
            .sonics-timeline
              canvas#timeline-canvas(width="800" height="60")
              .sonics-timeline__labels#timeline-labels

  footer.site-footer
